# CampusSync environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local or any real secret.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser: never put secrets there.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Site URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Verifiable Credentials (required) ---
# CURRENT private signing key as a single-line JSON JWK (contains private fields).
# Ed25519 (alg EdDSA) is recommended; ES256 and RS256 are also accepted. `kid` is optional:
# when absent, the RFC 7638 thumbprint of the public key is used.
# Generate a NEW key per environment; never reuse a key that was ever committed.
# Replacing a key in use: follow docs/KEY-ROTATION.md (re-sign stored credentials before dropping the old key).
VC_ISSUER_JWK={"kty":"RSA","use":"sig","alg":"RS256","kid":"replace-me","n":"...","e":"AQAB","d":"..."}
# Credential validity period in days (intended default: 730)
VC_VALIDITY_DAYS=730
NEXT_PUBLIC_ISSUER_DID=did:web:your-domain.example
# Legacy: no longer used when signing. New credentials use "<NEXT_PUBLIC_ISSUER_DID>#<kid>"
# (kid of the signing key), which resolves via /.well-known/did.json.
NEXT_PUBLIC_ISSUER_VERIFICATION_METHOD=did:web:your-domain.example#keys-1
# Recommended key type: Ed25519. Generate one with: node scripts/generate-issuer-key.mjs
# Key rotation: move the OLD key's PUBLIC JWK into this JSON array (public members only; an entry
# with a private member is rejected) and put the NEW private key into VC_ISSUER_JWK.
# After every stored credential was re-signed with the new key (POST /api/admin/vcs/resign), set this back to []
# so the old key is no longer trusted. Full procedure: docs/KEY-ROTATION.md.
VC_ISSUER_PREVIOUS_PUBLIC_JWKS=[]
# "true" enables the revocation status list (needs supabase/migrations/20261014_vc_status_lists.sql). Default: off
VC_STATUS_LIST_ENABLED=false

# --- Transparency log (optional; default OFF) ---
# Apply supabase/migrations/20261014_tlog_transparency_log.sql first. See docs/TRANSPARENCY-LOG.md.
TRANSPARENCY_LOG_ENABLED=false
# SERVER ONLY. Per-deployment secret (>= 16 random chars) used to pseudonymise student ids in log entries.
# Changing it breaks the pseudonym link to earlier entries; keep it stable and never commit it.
TRANSPARENCY_LOG_SALT=replace-with-a-long-random-string
# Optional stable identifier embedded in signed tree heads (default: <NEXT_PUBLIC_ISSUER_DID>#transparency-log)
TRANSPARENCY_LOG_ID=

# --- OCR / AI ---
GEMINI_API_KEY=your-gemini-api-key
# Gemini model used for certificate OCR/extraction (honored when set)
GEMINI_MODEL=gemini-2.0-flash
OCR_ENABLED=true
# Optional external OCR service
OCR_SERVICE_URL=

# --- Email (optional; set all SMTP_* or none) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="CampusSync <no-reply@example.com>"

# --- Misc ---
ENABLE_MONITORING=false
# Optional. https incoming-webhook URL (Slack, Discord or any JSON endpoint). When set, unexpected
# server errors raise a throttled, redacted alert. Unset = no alerts. See docs/MONITORING.md.
# Treat the URL as a secret: anyone who has it can post to your channel.
ALERT_WEBHOOK_URL=

# --- Selective disclosure (SD-JWT) ---
# Set to true to enable /api/credentials/sd/* and the /student/share + /verify/sd pages (default: off).
# Optional accounting table: supabase/migrations/20261014_sd_issuances.sql (optional; the app works without it).
SD_JWT_ENABLED=false
